#!/usr/bin/env python3
"""Stand-in for a real team tool: records the call instead of acting."""
import json, pathlib, sys, time
log = pathlib.Path(__file__).resolve().parent.parent / ".effects.log"
with log.open("a") as handle:
    handle.write(json.dumps({"tool": "send_email", "args": sys.argv[1:], "ts": time.time()}) + "\n")
print("send_email: done")
